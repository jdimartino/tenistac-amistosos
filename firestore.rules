rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // USUARIOS: admin escribe; usuario lee solo su propio doc.
    match /usuarios/{uid} {
      allow read: if isAdmin() || isOwner(uid);
      allow create, update, delete: if isAdmin();
    }

    // RESERVAS: cualquier usuario logueado lee; capitán crea su solicitud si el día no está bloqueado.
    match /reservas/{reservaId} {
      allow read: if signedIn();

      // Crear solicitud sin turno/cancha (solo fecha y preferencia de turno)
      allow create: if signedIn()
        && request.resource.data.estado == 'solicitado'
        && request.resource.data.capitanUid == request.auth.uid
        && request.resource.data.turno == null
        && request.resource.data.cancha == null
        && request.resource.data.turnoPreferencia in ['maniana', 'tarde', 'cualquiera']
        && !exists(/databases/$(database)/documents/bloqueos/$(request.resource.data.fecha));

      // Capitán puede cancelar su propia solicitud pendiente
      allow delete: if signedIn()
        && resource.data.capitanUid == request.auth.uid
        && resource.data.estado == 'solicitado';

      // Solo admin puede asignar turno/cancha y aprobar
      allow update: if isAdmin();
    }

    // BLOQUEOS: legibles para usuarios logueados; escritura SOLO a través de Cloud Functions (Admin SDK).
    match /bloqueos/{bloqueoId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // SLOTS BLOQUEADOS: colección derivada. Solo Cloud Functions escribe; todos los usuarios leen.
    match /slotsBloqueados/{slotId} {
      allow read: if signedIn();
      allow write: if false;
    }
  }
}
