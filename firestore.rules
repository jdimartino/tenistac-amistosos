rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // USUARIOS: admin escribe; usuario lee solo su propio doc.
    match /usuarios/{uid} {
      allow read: if isAdmin() || isOwner(uid);
      allow create, update, delete: if isAdmin();
    }

    // RESERVAS: cualquier usuario logueado lee; capitán crea su solicitud si el día no está bloqueado.
    match /reservas/{reservaId} {
      allow read: if signedIn();

      // Crear solicitud sin turno/cancha (solo fecha, preferencia de turno y motivo)
      allow create: if signedIn()
        && request.resource.data.estado == 'solicitado'
        && request.resource.data.capitanUid == request.auth.uid
        && request.resource.data.turno == null
        && request.resource.data.canchas.size() == 0
        && request.resource.data.turnoPreferencia in ['maniana', 'tarde', 'noche', 'cualquiera']
        && request.resource.data.motivo in ['amistoso', 'clases', 'torneo']
        && request.resource.data.solicitaChuruata is bool
        && !exists(/databases/$(database)/documents/bloqueos/$(request.resource.data.fecha));

      // Capitán puede cancelar su propia solicitud pendiente; admin puede borrar cualquier reserva
      allow delete: if signedIn()
        && (resource.data.capitanUid == request.auth.uid && resource.data.estado == 'solicitado'
         || isAdmin());

      // Solo admin puede asignar turno/cancha y aprobar
      allow update: if isAdmin();
    }

    // BLOQUEOS: legibles para usuarios logueados; escritura SOLO a través de Cloud Functions (Admin SDK).
    match /bloqueos/{bloqueoId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // SLOTS BLOQUEADOS: colección derivada. Solo Cloud Functions escribe; admin puede borrar slots individuales.
    match /slotsBloqueados/{slotId} {
      allow read: if signedIn();
      allow create, update: if false;
      allow delete: if isAdmin();
    }

    // MENSAJES: cualquier usuario logueado lee (si es para él, de él, o para admin);
    // crea si es suyo; solo dueño puede marcar leído o borrar.
    match /mensajes/{mensajeId} {
      allow read: if signedIn()
        && (resource.data.paraUid == request.auth.uid
         || resource.data.deUid == request.auth.uid
         || resource.data.paraUid == 'admin');
      allow create: if signedIn()
        && request.resource.data.deUid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.paraUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leido']);
      allow delete: if signedIn()
        && resource.data.paraUid == request.auth.uid;
    }

    // LOGS: solo admin puede leer (auditoría); escritura SOLO a través de Cloud Functions (Admin SDK).
    match /logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
